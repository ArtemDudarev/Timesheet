# =========================
# COMMON
# =========================
DB_USER=admin
DB_PASSWORD=secret_password

# =========================
# JWT
# =========================
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# =========================
# CORS / COOKIES
# =========================
# Адрес фронтенда, которому разрешены запросы к API.
# Для локальной разработки: http://localhost:3000
# Для VPS: заменить на реальный домен, например https://yourdomain.com
# Несколько доменов разделяются запятой: https://yourdomain.com,https://dev.yourdomain.com
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# =========================
# SERVICES PORTS
# =========================
AUTH_SERVICE_PORT=8001
PROFILE_SERVICE_PORT=8002
MANAGEMENT_SERVICE_PORT=8003
TIMESHEET_SERVICE_PORT=8004
REPORTING_SERVICE_PORT=8005
ABSENCE_SERVICE_PORT=8006
DOCUMENT_SERVICE_PORT=8007
NOTIFICATION_SERVICE_PORT=8008
CHAT_SERVICE_PORT=8009

# =========================
# DATABASE PORTS
# =========================
AUTH_DB_PORT=5431
PROFILE_DB_PORT=5432
MANAGEMENT_DB_PORT=5433
TIMESHEET_DB_PORT=5434
REPORTING_DB_PORT=5435
ABSENCE_DB_PORT=5436
DOCUMENT_DB_PORT=5437
NOTIFICATION_DB_PORT=5438
CHAT_DB_PORT=5439

# =========================
# KAFKA
# =========================

# Для контейнеров внутри docker network
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Для подключения с хоста
KAFKA_EXTERNAL_PORT=9092

# Internal listener
KAFKA_INTERNAL_PORT=29092

# Controller listener
KAFKA_CONTROLLER_PORT=29093

# =========================
# KAFKA UI
# =========================
KAFKA_UI_PORT=8080